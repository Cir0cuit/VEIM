# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# VEIM runtime output
veim.log
# Working captures. The ones the README embeds live in docs/images/ and are
# committed; this is the scratch directory the capture tool writes to.
screenshots/

# Downloaded brand assets are re-fetched on first run; keeping them out of git
# avoids committing third-party logos.
src/assets/icons/*.png
src/assets/icons/*.svg
# chevron_down is our own UI chrome, not a downloaded logo: the stylesheet
# points QComboBox's arrow at it and nothing ever fetches it, so a clone
# without it renders every dropdown with no arrow.
!src/assets/icons/chevron_down.png
!src/assets/icons/chevron_down.svg
# Marker recording the icon cache format; regenerated at runtime.
src/assets/icons/.cache_format

# Local knowledge-graph output
graphify-out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
