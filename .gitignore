# VEIM runtime output
veim.log
# Working captures. The ones the README embeds live in docs/images/ and are
# committed; this is the scratch directory the capture tool writes to.
screenshots/

# The rendered distribution logos in src/assets/icons/ are committed, so a
# fresh install shows every row's icon before any network call. Regenerate them
# with tools/fetch_icons.py.
# This marker is runtime state, written next to a user's own icon cache.
src/assets/icons/.cache_format

# Local knowledge-graph output
graphify-out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
